    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jimp": "^1.6.1",
    "prisma": "^5.22.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
